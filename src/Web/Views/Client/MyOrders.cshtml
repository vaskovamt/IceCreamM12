@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

<p>Review current and past orders submitted by your account.</p>

<section>
    <h2>Order status overview</h2>
    <ul>
        <li>Pending: Awaiting confirmation.</li>
        <li>In production: Being prepared by the team.</li>
        <li>Ready: Packaged and scheduled for delivery.</li>
        <li>Completed: Delivered and archived.</li>
    </ul>
</section>

<section>
    <h2>Next steps</h2>
    <p>Need a new order? Start a request from the New Order page.</p>
</section>
