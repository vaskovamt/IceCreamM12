@model IceCreamM12.Domain.Entities.Product
<h1>Детайли за продукта</h1><dl class="row"><dt class="col-sm-3">Име</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Описание</dt><dd class="col-sm-9">@Model.Description</dd><dt class="col-sm-3">Цена</dt><dd class="col-sm-9">@Model.Price.ToString("C")</dd><dt class="col-sm-3">Категория</dt><dd class="col-sm-9">@Model.Category?.Name</dd><dt class="col-sm-3">Наличност</dt><dd class="col-sm-9">@(Model.InventoryItem?.QuantityOnHand ?? 0)</dd></dl>
