@{
    ViewData["Title"] = "Продукти";
}

<h1>Операции с продукти</h1>

<section>
    <h2>Бракуване на продукт</h2>
    <form asp-action="Scrap" method="post">
        <label>Номер на продукт</label>
        <input type="number" name="ProductId" />
        <label>Количество</label>
        <input type="number" name="Quantity" />
        <label>Причина</label>
        <input type="text" name="Reason" />
        <button type="submit">Бракувай</button>
    </form>
</section>

<section>
    <h2>Замяна на продукт</h2>
    <form asp-action="Replace" method="post">
        <label>Оригинален продукт №</label>
        <input type="number" name="OriginalProductId" />
        <label>Заместващ продукт №</label>
        <input type="number" name="ReplacementProductId" />
        <label>Количество</label>
        <input type="number" name="Quantity" />
        <label>Причина</label>
        <input type="text" name="Reason" />
        <button type="submit">Замени</button>
    </form>
</section>
