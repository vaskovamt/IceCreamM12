@model IceCreamM12.Web.Models.ViewModels.OrdersManagementViewModel
@{ ViewData["Title"] = "Поръчки"; }
<h1>Управление на поръчки</h1>
<form method="get" class="row g-2 mb-3"><div class="col-auto"><select name="status" class="form-select">
<option value="">Всички</option><option selected="@(Model.StatusFilter=="Pending")">Чакаща</option><option selected="@(Model.StatusFilter=="Approved")">Одобрена</option><option selected="@(Model.StatusFilter=="Rejected")">Отказана</option>
</select></div><div class="col-auto"><button class="btn btn-primary">Филтър</button></div></form>
<table class="table table-striped"><thead><tr><th>#</th><th>Клиент</th><th>Статус</th><th>Общо</th><th>Действия</th></tr></thead><tbody>
@foreach (var o in Model.Orders){<tr><td>@o.OrderNumber</td><td>@o.CustomerName</td><td>@o.Status</td><td>@o.TotalAmount.ToString("C")</td><td>
@if (o.Status.StartsWith("Pending")){<form asp-action="ApproveOrder" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@o.Id" /><button class="btn btn-sm btn-success">Одобри</button></form>
<form asp-action="RejectOrder" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@o.Id" /><input name="rejectionReason" class="form-control form-control-sm d-inline w-auto" placeholder="Причина" /><button class="btn btn-sm btn-danger">Откажи</button></form>}
</td></tr>}
</tbody></table>
