@model IceCreamM12.Web.Models.ViewModels.NewOrderViewModel
@{ ViewData["Title"] = "New Order"; }
<h1>New Order</h1>
<form asp-action="NewOrder" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="ProductId" class="form-label"></label><select asp-for="ProductId" class="form-select">
<option value="">Изберете продукт</option>
@foreach (var product in Model.AvailableProducts){<option value="@product.Id">@product.Name (налични: @(product.InventoryItem?.QuantityOnHand ?? 0))</option>}
</select><span asp-validation-for="ProductId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control"/><span asp-validation-for="Quantity" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control"/></div>
<div class="mb-3"><label asp-for="CustomerEmail" class="form-label"></label><input asp-for="CustomerEmail" class="form-control"/></div>
<button class="btn btn-primary">Submit</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
