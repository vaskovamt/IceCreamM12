@model IceCreamM12.Domain.Entities.Product
<h1>Create Product</h1><form asp-action="CreateProduct" method="post">@Html.AntiForgeryToken()<div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" class="form-control"/></div><div class="mb-2"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="mb-2"><label asp-for="Price"></label><input asp-for="Price" class="form-control"/></div><div class="mb-2"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.CategoryOptions" class="form-select"></select></div><button class="btn btn-primary">Save</button></form>
