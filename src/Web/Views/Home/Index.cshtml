@model IReadOnlyList<IceCreamM12.Domain.Entities.Product>

@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-5">Welcome to IceCreamM12</h1>
    <p class="lead">Explore featured products from our latest catalog.</p>
</div>

<div class="row g-3">
    @foreach (var product in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text mb-2">@product.Description</p>
                    <p class="card-text mt-auto">
                        Price: <strong>@product.Price.ToString("C")</strong>
                    </p>
                    @if (product.Category is not null)
                    {
                        <span class="badge bg-primary">@product.Category.Name</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
