@model IceCreamM12.Web.Models.ViewModels.ProductEditViewModel
<h1>Редакция на продукт</h1><form asp-action="EditProduct" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><div class="mb-2"><label asp-for="Name"></label><input asp-for="Name" class="form-control"/></div><div class="mb-2"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="mb-2"><label asp-for="Price"></label><input asp-for="Price" class="form-control"/></div><div class="mb-2"><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.CategoryOptions" class="form-select"></select></div><div class="mb-2"><label asp-for="QuantityOnHand"></label><input asp-for="QuantityOnHand" class="form-control"/></div><button class="btn btn-primary">Запази</button></form>
