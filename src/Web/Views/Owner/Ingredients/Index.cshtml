@model IEnumerable<IceCreamM12.Domain.Entities.Ingredient>
<h1>Ingredients</h1><a asp-action="CreateIngredient" class="btn btn-primary mb-2">Create</a>
<table class="table"><thead><tr><th>Name</th><th>Unit</th><th>Qty</th><th></th></tr></thead><tbody>@foreach(var i in Model){<tr><td>@i.Name</td><td>@i.Unit</td><td>@i.QuantityOnHand</td><td><a asp-action="IngredientDetails" asp-route-id="@i.Id">Details</a> | <a asp-action="EditIngredient" asp-route-id="@i.Id">Edit</a> | <a asp-action="DeleteIngredient" asp-route-id="@i.Id">Delete</a></td></tr>}</tbody></table>
