@model IReadOnlyList<IceCreamM12.Domain.Entities.IceCreamFlavor>

@{
    ViewData["Title"] = "Flavor Catalog";
}

<h1>Flavor Catalog (Admin)</h1>
<p class="text-muted">Use this list to review the menu currently stored in the database.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Seasonal</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var flavor in Model)
    {
        <tr>
            <td>@flavor.Name</td>
            <td>@flavor.Price.ToString("C")</td>
            <td>@(flavor.IsSeasonal ? "Yes" : "No")</td>
        </tr>
    }
    </tbody>
</table>
