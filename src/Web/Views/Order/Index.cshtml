@{
    ViewData["Title"] = "Поръчки";
}

<h1>Управление на поръчки</h1>

<section>
    <h2>Одобряване на поръчка</h2>
    <form asp-action="Approve" method="post">
        <label>Номер на поръчка</label>
        <input type="number" name="OrderId" />
        <button type="submit">Одобри</button>
    </form>
</section>

<section>
    <h2>Отказ на поръчка</h2>
    <form asp-action="Reject" method="post">
        <label>Номер на поръчка</label>
        <input type="number" name="OrderId" />
        <label>Причина за отказ</label>
        <input type="text" name="RejectionReason" />
        <button type="submit">Откажи</button>
    </form>
</section>
