@{
    ViewData["Title"] = "Производство";
}

<h1>Производство</h1>

<section>
    <h2>Произвеждане</h2>
    <form asp-action="Produce" method="post">
        <label>Номер на продукт</label>
        <input type="number" name="ProductId" />
        <label>Количество</label>
        <input type="number" name="Quantity" />
        <button type="submit">Произведи</button>
    </form>
</section>
