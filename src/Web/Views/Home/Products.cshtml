@model IReadOnlyList<IceCreamM12.Domain.Entities.Product>

@{
    ViewData["Title"] = "Продукти";

    IReadOnlyDictionary<string, string> productImages = new Dictionary<string, string>
    {
        ["0.100kg"] = Url.Content("~/images/0.100kg.jpg"),
        ["0.300kg"] = Url.Content("~/images/0.300kg.jpg"),
        ["0.500kg"] = Url.Content("~/images/0.500kg.jpg"),
        ["2.000kg"] = Url.Content("~/images/2.000kg.jpg"),
        ["2.500kg"] = Url.Content("~/images/2.500kg.jpg"),
        ["8.000kg"] = Url.Content("~/images/8.000kg.jpg")
    };

    static string? ExtractSize(string productName)
    {
        string[] supportedSizes = ["0.100kg", "0.300kg", "0.500kg", "2.000kg", "2.500kg", "8.000kg"];

        return supportedSizes.FirstOrDefault(productName.Contains);
    }
}

<div class="text-center mb-4">
    <h1 class="display-5">Продукти</h1>
    <p class="lead">Разгледайте пълния ни каталог.</p>
</div>

<div class="row g-3">
    @foreach (var product in Model)
    {
        string? productSize = ExtractSize(product.Name);
        productImages.TryGetValue(productSize ?? string.Empty, out string? productImage);

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrWhiteSpace(productImage))
                {
                    <img src="@productImage" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;" />
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text mb-2">@product.Description</p>
                    <p class="card-text mt-auto">
                        Цена: <strong>@product.Price.ToString("C")</strong>
                    </p>
                    @if (product.Category is not null)
                    {
                        <span class="badge bg-primary">@product.Category.Name</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
