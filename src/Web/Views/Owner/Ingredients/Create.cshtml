@model IceCreamM12.Domain.Entities.Ingredient
<h1>Създаване на суровина</h1><form asp-action="CreateIngredient" method="post">@Html.AntiForgeryToken()<input asp-for="Name" class="form-control mb-2" placeholder="Име"/><input asp-for="Unit" class="form-control mb-2" placeholder="Мярка"/><input asp-for="CostPerUnit" class="form-control mb-2" placeholder="Цена"/><input asp-for="QuantityOnHand" class="form-control mb-2" placeholder="Количество"/><input asp-for="ReorderLevel" class="form-control mb-2" placeholder="Минимално количество"/><button class="btn btn-primary">Запази</button></form>
