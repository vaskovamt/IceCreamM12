@model IceCreamM12.Web.Models.ViewModels.NewOrderViewModel
@{ ViewData["Title"] = "New Order"; }
<h1>New Order</h1>
<form asp-action="NewOrder" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<table class="table">
    <thead>
        <tr>
            <th>Продукт</th>
            <th style="width: 220px;">Количество</th>
        </tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Model.Items.Count; i++)
    {
        var item = Model.Items[i];
        var productName = Model.AvailableProducts.FirstOrDefault(p => p.Id == item.ProductId)?.Name ?? string.Empty;
        <tr>
            <td>
                @productName
                <input asp-for="Items[i].ProductId" type="hidden" />
            </td>
            <td>
                <input asp-for="Items[i].Quantity" class="form-control" min="0" />
                <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="mb-3"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control"/></div>
<div class="mb-3"><label asp-for="CustomerEmail" class="form-label"></label><input asp-for="CustomerEmail" class="form-control"/></div>
<button class="btn btn-primary">Submit</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
