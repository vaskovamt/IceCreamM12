@model IceCreamM12.Web.Models.ViewModels.OwnerDashboardViewModel
@{ ViewData["Title"] = "Owner Dashboard"; }
<h1>Owner Dashboard</h1>
<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="card"><div class="card-body"><h6>Pending Orders</h6><h3>@Model.Data.PendingOrdersCount</h3></div></div></div>
  <div class="col-md-3"><div class="card"><div class="card-body"><h6>Total Products</h6><h3>@Model.Data.TotalProducts</h3></div></div></div>
  <div class="col-md-3"><div class="card"><div class="card-body"><h6>Low Stock</h6><h3>@Model.Data.LowStockProducts.Count</h3></div></div></div>
  <div class="col-md-3"><div class="card"><div class="card-body"><h6>Recent Audits</h6><h3>@Model.Data.RecentAudits.Count</h3></div></div></div>
</div>
<h4>Low Stock Products</h4>
<table class="table table-sm table-striped"><thead><tr><th>Product</th><th>Qty</th></tr></thead><tbody>
@foreach (var p in Model.Data.LowStockProducts){<tr><td>@p.Name</td><td>@(p.InventoryItem?.QuantityOnHand ?? 0)</td></tr>}
</tbody></table>
<h4>Recent Inventory Audits</h4>
<table class="table table-sm table-bordered"><thead><tr><th>Date</th><th>Product</th><th>Change</th><th>Reason</th></tr></thead><tbody>
@foreach (var a in Model.Data.RecentAudits){<tr><td>@a.PerformedAt.ToLocalTime()</td><td>@a.InventoryItem?.Product?.Name</td><td>@a.QuantityChange</td><td>@a.Reason</td></tr>}
</tbody></table>
