@model IceCreamM12.Web.Models.ViewModels.DailyCheckViewModel
<h1>Daily Inventory Check</h1>
<form method="post">@Html.AntiForgeryToken()<table class="table"><thead><tr><th>Product</th><th>System</th><th>Counted</th></tr></thead><tbody>
@for(int i=0;i<Model.Items.Count;i++){<tr><td>@Model.Items[i].ProductName<input type="hidden" asp-for="Items[i].ProductId"/><input type="hidden" asp-for="Items[i].ProductName"/><input type="hidden" asp-for="Items[i].SystemQuantity"/></td><td>@Model.Items[i].SystemQuantity</td><td><input asp-for="Items[i].CountedQuantity" class="form-control"/></td></tr>}
</tbody></table><button class="btn btn-primary">Save Daily Check</button></form>
@if (Model.Results.Any())
{
<h3 class="mt-4">Mismatches</h3><table class="table table-bordered"><thead><tr><th>Product</th><th>System</th><th>Counted</th><th>Diff</th><th>Owner Review</th></tr></thead><tbody>@foreach(var r in Model.Results.Where(r=>r.HasMismatch)){<tr><td>@r.ProductName</td><td>@r.SystemQuantity</td><td>@r.CountedQuantity</td><td>@r.Difference</td><td>Marked</td></tr>}</tbody></table>
}
