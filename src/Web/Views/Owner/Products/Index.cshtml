@model IEnumerable<IceCreamM12.Domain.Entities.Product>
<h1>Products</h1><a asp-action="CreateProduct" class="btn btn-primary mb-2">Create</a>
<table class="table table-striped"><thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category?.Name</td><td>@p.Price</td><td>@(p.InventoryItem?.QuantityOnHand ?? 0)</td><td><a asp-action="ProductDetails" asp-route-id="@p.Id">Details</a> | <a asp-action="EditProduct" asp-route-id="@p.Id">Edit</a> | <a asp-action="DeleteProduct" asp-route-id="@p.Id">Delete</a></td></tr>}</tbody></table>
