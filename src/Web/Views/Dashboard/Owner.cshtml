@{
    ViewData["Title"] = "Owner Dashboard";
}

<div class="mb-4">
    <h1 class="mb-2">Owner Dashboard</h1>
    <p class="text-muted mb-0">Централизирана зона за контрол върху поръчки, наличности, продукти и дневни операции.</p>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Управление на поръчки</h5>
                <p class="card-text text-muted">Преглеждайте чакащи заявки и вземайте решение за одобрение или отказ.</p>
                <a asp-controller="Owner" asp-action="Orders" class="btn btn-primary btn-sm">Към поръчките</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Продукти и категории</h5>
                <p class="card-text text-muted">Поддържайте продуктовото портфолио, категории и детайли за наличните артикули.</p>
                <a asp-controller="Owner" asp-action="Products" class="btn btn-outline-primary btn-sm">Продукти</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Склад и движения</h5>
                <p class="card-text text-muted">Зареждане, бракуване и замяна на продукти със следене на последните одити.</p>
                <a asp-controller="Owner" asp-action="Inventory" class="btn btn-outline-primary btn-sm">Инвентар</a>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4" role="alert">
    <strong>Съвет:</strong> за оперативна картина в реално време използвайте разширеното табло от <a asp-controller="Owner" asp-action="Dashboard" class="alert-link">Owner Dashboard</a> в ролите.
</div>
