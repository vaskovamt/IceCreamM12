@model IceCreamM12.Web.Models.ViewModels.DailyCheckViewModel
<h1>Дневна складова проверка</h1>
<form method="post">@Html.AntiForgeryToken()<table class="table"><thead><tr><th>Продукт</th><th>Системно</th><th>Преброено</th></tr></thead><tbody>
@for(int i=0;i<Model.Items.Count;i++){<tr><td>@Model.Items[i].ProductName<input type="hidden" asp-for="Items[i].ProductId"/><input type="hidden" asp-for="Items[i].ProductName"/><input type="hidden" asp-for="Items[i].SystemQuantity"/></td><td>@Model.Items[i].SystemQuantity</td><td><input asp-for="Items[i].CountedQuantity" class="form-control"/></td></tr>}
</tbody></table><button class="btn btn-primary">Запази проверката</button></form>
@if (Model.Results.Any())
{
<h3 class="mt-4">Разминавания</h3><table class="table table-bordered"><thead><tr><th>Продукт</th><th>Системно</th><th>Преброено</th><th>Разлика</th><th>Преглед от собственик</th></tr></thead><tbody>@foreach(var r in Model.Results.Where(r=>r.HasMismatch)){<tr><td>@r.ProductName</td><td>@r.SystemQuantity</td><td>@r.CountedQuantity</td><td>@r.Difference</td><td>Отбелязано</td></tr>}</tbody></table>
}
