@model IEnumerable<IceCreamM12.Domain.Entities.Product>
<h1>Продукти</h1><a asp-action="CreateProduct" class="btn btn-primary mb-2">Създай</a>
<table class="table table-striped"><thead><tr><th>Име</th><th>Категория</th><th>Цена</th><th>Наличност</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category?.Name</td><td>@p.Price.ToString("C")</td><td>@(p.InventoryItem?.QuantityOnHand ?? 0)</td><td><a asp-action="ProductDetails" asp-route-id="@p.Id">Детайли</a> | <a asp-action="EditProduct" asp-route-id="@p.Id">Редакция</a> | <a asp-action="DeleteProduct" asp-route-id="@p.Id">Изтрий</a></td></tr>}</tbody></table>
