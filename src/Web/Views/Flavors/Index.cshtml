@model IReadOnlyList<IceCreamM12.Domain.Entities.IceCreamFlavor>

@{
    ViewData["Title"] = "Каталог вкусове";
}

<h1>Каталог вкусове (админ)</h1>
<p class="text-muted">Използвайте този списък, за да прегледате менюто в базата данни.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Име</th>
            <th>Цена</th>
            <th>Сезонен</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var flavor in Model)
    {
        <tr>
            <td>@flavor.Name</td>
            <td>@flavor.Price.ToString("C")</td>
            <td>@(flavor.IsSeasonal ? "Да" : "Не")</td>
        </tr>
    }
    </tbody>
</table>
