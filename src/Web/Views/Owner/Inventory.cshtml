@model IceCreamM12.Web.Models.ViewModels.InventoryManagementViewModel
@{ ViewData["Title"] = "Inventory Management"; }
<h1>Inventory Management</h1>
<div class="row g-3">
<div class="col-md-4"><div class="card"><div class="card-header">Load</div><div class="card-body"><form asp-action="Load" method="post">@Html.AntiForgeryToken()<select asp-for="Load.ProductId" class="form-select mb-2">@foreach(var i in Model.InventoryItems){<option value="@i.ProductId">@i.Product?.Name</option>}</select><input asp-for="Load.Quantity" class="form-control mb-2" placeholder="Qty" /><input asp-for="Load.Reason" class="form-control mb-2" placeholder="Причина" /><span asp-validation-for="Load.Reason" class="text-danger"></span><button class="btn btn-primary">Load</button></form></div></div></div>
<div class="col-md-4"><div class="card"><div class="card-header">Scrap</div><div class="card-body"><form asp-action="Scrap" method="post">@Html.AntiForgeryToken()<select asp-for="Scrap.ProductId" class="form-select mb-2">@foreach(var i in Model.InventoryItems){<option value="@i.ProductId">@i.Product?.Name</option>}</select><input asp-for="Scrap.Quantity" class="form-control mb-2" placeholder="Qty" /><input asp-for="Scrap.Reason" class="form-control mb-2" placeholder="Причина" /><span asp-validation-for="Scrap.Reason" class="text-danger"></span><button class="btn btn-warning">Scrap</button></form></div></div></div>
<div class="col-md-4"><div class="card"><div class="card-header">Replace</div><div class="card-body"><form asp-action="Replace" method="post">@Html.AntiForgeryToken()<select asp-for="Replace.FromProductId" class="form-select mb-2">@foreach(var i in Model.InventoryItems){<option value="@i.ProductId">@i.Product?.Name</option>}</select><select asp-for="Replace.ToProductId" class="form-select mb-2">@foreach(var i in Model.InventoryItems){<option value="@i.ProductId">@i.Product?.Name</option>}</select><input asp-for="Replace.Quantity" class="form-control mb-2" placeholder="Qty" /><input asp-for="Replace.Reason" class="form-control mb-2" placeholder="Причина" /><span asp-validation-for="Replace.Reason" class="text-danger"></span><button class="btn btn-secondary">Replace</button></form></div></div></div>
</div>
<h4 class="mt-4">Current Stock</h4><table class="table"><thead><tr><th>Product</th><th>Qty</th></tr></thead><tbody>@foreach(var i in Model.InventoryItems){<tr><td>@i.Product?.Name</td><td>@i.QuantityOnHand</td></tr>}</tbody></table>
