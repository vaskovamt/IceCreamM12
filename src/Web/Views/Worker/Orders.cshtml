@model IceCreamM12.Web.Models.ViewModels.OrdersManagementViewModel
<h1>Pending Orders</h1>
<table class="table"><thead><tr><th>#</th><th>Customer</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var o in Model.Orders){<tr><td>@o.OrderNumber</td><td>@o.CustomerName</td><td>@o.TotalAmount</td><td><form asp-action="ApproveOrder" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@o.Id"/><button class="btn btn-success btn-sm">Approve</button></form><form asp-action="RejectOrder" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@o.Id"/><input name="rejectionReason" class="form-control form-control-sm d-inline w-auto" placeholder="Reason"/><button class="btn btn-danger btn-sm">Reject</button></form></td></tr>}</tbody></table>
