@model IReadOnlyList<IceCreamM12.Domain.Entities.Product>

@{
    ViewData["Title"] = "Продукти";

    IReadOnlyDictionary<string, string> productImages = new Dictionary<string, string>
    {
        ["0.100kg"] = Url.Content("~/images/0.100kg.jpg"),
        ["0.300kg"] = Url.Content("~/images/0.300kg.jpg"),
        ["0.500kg"] = Url.Content("~/images/0.500kg.jpg"),
        ["2.000kg"] = Url.Content("~/images/2.000kg.jpg"),
        ["2.500kg"] = Url.Content("~/images/2.500kg.jpg"),
        ["8.000kg"] = Url.Content("~/images/8.000kg.jpg"),
        ["Вафлено рогче"] = Url.Content("~/images/cone-waffle-horn.jpg"),
        ["Вафлена Чашка"] = Url.Content("~/images/cone-waffle-cup.jpg"),
        ["Захарно рогче"] = Url.Content("~/images/cone-sugar-horn.jpg")
    };

    IReadOnlyDictionary<string, string> sizeDescriptions = new Dictionary<string, string>
    {
        ["0.100kg"] = "Идеална единична порция за бързо похапване.",
        ["0.300kg"] = "Подходяща за споделяне или по-голяма порция.",
        ["0.500kg"] = "Семеен размер за няколко порции у дома.",
        ["2.000kg"] = "Професионален размер за събития и заведения.",
        ["2.500kg"] = "Голям размер за натоварени обекти.",
        ["8.000kg"] = "Най-голямият размер за масово обслужване."
    };

    static string? ExtractIceCreamSize(string productName)
    {
        string[] supportedSizes = ["0.100kg", "0.300kg", "0.500kg", "2.000kg", "2.500kg", "8.000kg"];
        return supportedSizes.FirstOrDefault(productName.Contains);
    }

    static string? ExtractConeType(string productName)
    {
        string[] coneTypes = ["Вафлено рогче", "Вафлена Чашка", "Захарно рогче"];
        return coneTypes.FirstOrDefault(productName.Contains);
    }

    var uniqueIceCreams = Model
        .Where(product => product.Name.StartsWith("Сладолед", StringComparison.OrdinalIgnoreCase))
        .GroupBy(product => ExtractIceCreamSize(product.Name) ?? product.Name)
        .Select(group => group.First())
        .OrderBy(product => ExtractIceCreamSize(product.Name))
        .ToList();

    var uniqueCones = Model
        .Where(product => product.Name.StartsWith("Фунийка", StringComparison.OrdinalIgnoreCase))
        .GroupBy(product => ExtractConeType(product.Name) ?? product.Name)
        .Select(group => group.First())
        .OrderBy(product => ExtractConeType(product.Name))
        .ToList();
}

<div class="text-center mb-4">
    <h1 class="display-5">Продукти</h1>
    <p class="lead">Разгледайте пълния ни каталог.</p>

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <a asp-controller="Home"
           asp-action="LoginRegister"
           class="btn btn-primary btn-lg mt-2">
            Искаш да поръчаш?
        </a>
    }
</div>

<h2 class="h4 mb-3">Сладолед по размер</h2>
<div class="row g-3 mb-5">
    @foreach (var product in uniqueIceCreams)
    {
        string? productSize = ExtractIceCreamSize(product.Name);
        productImages.TryGetValue(productSize ?? string.Empty, out string? productImage);
        sizeDescriptions.TryGetValue(productSize ?? string.Empty, out string? sizeDescription);

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrWhiteSpace(productImage))
                {
                    <img src="@productImage" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;" />
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@productSize</h5>
                    <p class="card-text mb-2">@(sizeDescription ?? "Описание за този размер не е налично.")</p>
                    <p class="card-text mt-auto">
                        Цена от: <strong>@product.Price.ToString("C")</strong>
                    </p>
                    <span class="badge bg-primary">Сладолед</span>
                </div>
            </div>
        </div>
    }
</div>

<h2 class="h4 mb-3">Фунийки</h2>
<div class="row g-3">
    @foreach (var product in uniqueCones)
    {
        string? coneType = ExtractConeType(product.Name);
        productImages.TryGetValue(coneType ?? string.Empty, out string? coneImage);

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrWhiteSpace(coneImage))
                {
                    <img src="@coneImage" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;" />
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@coneType</h5>
                    <p class="card-text mb-2">@(product.Description ?? "Класическа фунийка за сервиране на сладолед.")</p>
                    <p class="card-text mt-auto">
                        Цена: <strong>@product.Price.ToString("C")</strong>
                    </p>
                    <span class="badge bg-secondary">Фунийка</span>
                </div>
            </div>
        </div>
    }
</div>
