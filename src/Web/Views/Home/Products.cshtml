@model IReadOnlyList<IceCreamM12.Domain.Entities.Product>

@{
    ViewData["Title"] = "Продукти";

    IReadOnlyDictionary<string, string> productImages = new Dictionary<string, string>
    {
        ["0.100kg"] = Url.Content("~/images/0.100kg.jpg"),
        ["0.300kg"] = Url.Content("~/images/0.300kg.jpg"),
        ["0.500kg"] = Url.Content("~/images/0.500kg.jpg"),
        ["2.000kg"] = Url.Content("~/images/2.000kg.jpg"),
        ["2.500kg"] = Url.Content("~/images/2.500kg.jpg"),
        ["8.000kg"] = Url.Content("~/images/8.000kg.jpg"),
        ["Вафлено рогче"] = Url.Content("~/images/Vafleno rogche.jpg"),
        ["Вафлена Чашка"] = Url.Content("~/images/Vaflena chashka.jpg"),
        ["Захарно рогче"] = Url.Content("~/images/Zaharno rogche.jpg")
    };

    IReadOnlyDictionary<string, string> sizeDescriptions = new Dictionary<string, string>
    {
        ["0.100kg"] = "Перфектна единична порция.",
        ["0.300kg"] = "Удобна порция за споделяне.",
        ["0.500kg"] = "Семеен размер за вкъщи.",
        ["2.000kg"] = "Подходящ за събития и заведения.",
        ["2.500kg"] = "Голям обем за натоварени обекти.",
        ["8.000kg"] = "Максимален размер за масово обслужване."
    };

    IReadOnlyDictionary<string, string> coneDescriptions = new Dictionary<string, string>
    {
        ["Вафлено рогче"] = "Хрупкаво вафлено рогче с класически вкус.",
        ["Вафлена Чашка"] = "Стабилна вафлена чашка за щедра порция.",
        ["Захарно рогче"] = "Сладко и хрупкаво захарно рогче."
    };

    static string GetOptimizedMenuDescription(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        const int maxLength = 90;
        string normalized = string.Join(' ', value.Split(' ', StringSplitOptions.RemoveEmptyEntries));
        return normalized.Length <= maxLength
            ? normalized
            : string.Concat(normalized.AsSpan(0, maxLength - 1), "…");
    }

    static string? ExtractIceCreamSize(string productName)
    {
        string[] supportedSizes = ["0.100kg", "0.300kg", "0.500kg", "2.000kg", "2.500kg", "8.000kg"];
        return supportedSizes.FirstOrDefault(productName.Contains);
    }

    static string? ExtractIceCreamFlavor(string productName)
    {
        const string separator = " - ";
        int separatorIndex = productName.IndexOf(separator, StringComparison.Ordinal);
        if (separatorIndex < 0)
        {
            return null;
        }

        return productName[(separatorIndex + separator.Length)..].Trim();
    }

    static string? ExtractConeType(string productName)
    {
        string[] coneTypes = ["Вафлено рогче", "Вафлена Чашка", "Захарно рогче"];
        return coneTypes.FirstOrDefault(productName.Contains);
    }

    var uniqueIceCreams = Model
        .Where(product => product.Name.StartsWith("Сладолед", StringComparison.OrdinalIgnoreCase))
        .GroupBy(product => ExtractIceCreamSize(product.Name) ?? product.Name)
        .Select(group => group.First())
        .OrderBy(product => ExtractIceCreamSize(product.Name))
        .ToList();

    var uniqueCones = Model
        .Where(product => product.Name.StartsWith("Фунийка", StringComparison.OrdinalIgnoreCase))
        .GroupBy(product => ExtractConeType(product.Name) ?? product.Name)
        .Select(group => group.First())
        .OrderBy(product => ExtractConeType(product.Name))
        .ToList();
}

<section class="public-page-wrap">
<div class="public-page-head text-center mb-4">
    <h1 class="display-5">Продукти</h1>
    <p class="lead">Разгледайте пълния ни каталог.</p>

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <a asp-area="Identity"
           asp-page="/Account/Register"
           class="btn btn-lux-primary btn-lg mt-2">
            Искаш да поръчаш?
        </a>
    }
</div>

<h2 class="h4 mb-3">Сладолед по размер</h2>
<div class="row g-3 mb-5">
    @foreach (var product in uniqueIceCreams)
    {
        string? productSize = ExtractIceCreamSize(product.Name);
        productImages.TryGetValue(productSize ?? string.Empty, out string? productImage);
        sizeDescriptions.TryGetValue(productSize ?? string.Empty, out string? sizeDescription);
        string availableFlavors = string.Join(", ",
            Model
                .Where(item => ExtractIceCreamSize(item.Name) == productSize)
                .Select(item => ExtractIceCreamFlavor(item.Name))
                .Where(flavor => !string.IsNullOrWhiteSpace(flavor))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(flavor => flavor));

        <div class="col-md-6 col-lg-4">
            <div class="card product-card h-100">
                @if (!string.IsNullOrWhiteSpace(productImage))
                {
                    <img src="@productImage"
                         class="card-img-top product-image"
                         alt="@product.Name"
                         width="640"
                         height="220"
                         loading="lazy"
                         decoding="async" />
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@productSize</h5>
                    <p class="card-text mb-2">@GetOptimizedMenuDescription(sizeDescription, "Описание за този размер не е налично.")</p>
                    <p class="card-text mb-2">
                        <strong>Вкусове:</strong>
                        @(string.IsNullOrWhiteSpace(availableFlavors) ? "Няма налични вкусове." : availableFlavors)
                    </p>
                    <p class="card-text mt-auto">
                        Цена от: <strong>@product.Price.ToString("C")</strong>
                    </p>
                    <span class="badge product-badge">Сладолед</span>
                </div>
            </div>
        </div>
    }
</div>

<h2 class="h4 mb-3">Фунийки</h2>
<div class="row g-3">
    @foreach (var product in uniqueCones)
    {
        string? coneType = ExtractConeType(product.Name);
        productImages.TryGetValue(coneType ?? string.Empty, out string? coneImage);
        coneDescriptions.TryGetValue(coneType ?? string.Empty, out string? coneDescription);

        <div class="col-md-6 col-lg-4">
            <div class="card product-card h-100">
                @if (!string.IsNullOrWhiteSpace(coneImage))
                {
                    <img src="@coneImage"
                         class="card-img-top product-image"
                         alt="@product.Name"
                         width="640"
                         height="220"
                         loading="lazy"
                         decoding="async" />
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@coneType</h5>
                    <p class="card-text mb-2">@GetOptimizedMenuDescription(product.Description ?? coneDescription, "Класическа фунийка за сервиране на сладолед.")</p>
                    <p class="card-text mt-auto">
                        Цена: <strong>@product.Price.ToString("C")</strong>
                    </p>
                    <span class="badge product-badge product-badge-cone">Фунийка</span>
                </div>
            </div>
        </div>
    }
</div>

</section>
