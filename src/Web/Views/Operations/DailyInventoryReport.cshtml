@{
    ViewData["Title"] = "Daily Inventory Report";
}

<h1>Daily Inventory Report</h1>

<p>Capture daily inventory movements and reconciliation.</p>

<section>
    <h2>Report sections</h2>
    <ul>
        <li>Opening stock by ingredient and packaging.</li>
        <li>Usage tied to production batches.</li>
        <li>New deliveries or transfers.</li>
        <li>Closing stock and variance notes.</li>
    </ul>
</section>

<section>
    <h2>Submission checklist</h2>
    <ol>
        <li>Confirm counts with the storage team.</li>
        <li>Record any variances and reasons.</li>
        <li>Submit report by end of shift.</li>
    </ol>
</section>
