@{
    ViewData["Title"] = "Production";
}

<h1>Production</h1>

<p>Plan batches, assign tasks, and track output.</p>

<section>
    <h2>Production steps</h2>
    <ol>
        <li>Confirm recipe and ingredient availability.</li>
        <li>Prepare mix and pasteurize.</li>
        <li>Churn, flavor, and package.</li>
        <li>Log batch output and quality checks.</li>
    </ol>
</section>

<section>
    <h2>Quality checkpoints</h2>
    <ul>
        <li>Temperature logs for each batch.</li>
        <li>Texture and taste verification.</li>
        <li>Packaging and labeling review.</li>
    </ul>
</section>
