<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IceCreamM12</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">IceCreamM12</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Products">Продукти</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Контакти</a></li>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        if (User.IsInRole("Client"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="MyOrders">Моите поръчки</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="NewOrder">Нова поръчка</a></li>
                        }

                        if (User.IsInRole("Worker"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="Dashboard">Табло служител</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="Orders">Чакащи поръчки</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="OrderHistory">Поръчки</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="NewOrder">Нова поръчка</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="Inventory">Склад</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="Production">Производство</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Worker" asp-action="DailyCheck">Дневна проверка</a></li>
                        }

                        if (User.IsInRole("Owner"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Owner" asp-action="Dashboard">Табло собственик</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Owner" asp-action="Products">Продукти</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Owner" asp-action="Ingredients">Суровини</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Owner" asp-action="Inventory">Склад</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Owner" asp-action="Orders">Поръчки</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Owner" asp-action="Users">Потребители</a></li>
                        }
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>

<main class="container mt-4">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
