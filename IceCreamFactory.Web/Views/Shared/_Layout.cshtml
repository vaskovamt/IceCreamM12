<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IceCreamFactory</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer>
        <p>&copy; @DateTime.UtcNow.Year - IceCreamFactory</p>
    </footer>
</body>
</html>
