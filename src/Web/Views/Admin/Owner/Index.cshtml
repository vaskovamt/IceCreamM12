@{
    ViewData["Title"] = "Администрация собственик";
}

<h1>Администрация на собственика</h1>

<p>Управление на складови корекции и одитни записи.</p>

<section>
    <h2>Запиши промяна в склада</h2>
    <form asp-action="RecordInventoryChange" method="post">
        <label>Номер на продукт</label>
        <input type="number" name="ProductId" />
        <label>Количество</label>
        <input type="number" name="Quantity" />
        <label>Причина</label>
        <input type="text" name="Reason" />
        <button type="submit">Запиши промяната</button>
    </form>
</section>
