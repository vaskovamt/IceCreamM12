@model IceCreamM12.Web.Models.ViewModels.InventoryManagementViewModel
@using IceCreamM12.Web.Models.ViewModels
@{ ViewData["Title"] = "Управление на склад"; }
<h1>Управление на склад</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Зареждане</div>
            <div class="card-body">
                <form asp-action="Load" method="post">
                    @Html.AntiForgeryToken()

                    <select asp-for="Load.ItemType" class="form-select mb-2 js-item-type" data-target-prefix="load">
                        <option value="@((int)InventoryEntityType.Product)">Продукт</option>
                        <option value="@((int)InventoryEntityType.Ingredient)">Суровина</option>
                    </select>

                    <select asp-for="Load.ProductId" class="form-select mb-2 js-product-select" data-prefix="load">
                        <option value="">-- Изберете продукт --</option>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <option value="@item.ProductId">@item.Product?.Name</option>
                        }
                    </select>

                    <select asp-for="Load.IngredientId" class="form-select mb-2 js-ingredient-select d-none" data-prefix="load">
                        <option value="">-- Изберете суровина --</option>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit)</option>
                        }
                    </select>

                    <input asp-for="Load.Quantity" class="form-control mb-2" placeholder="Количество" />
                    <input asp-for="Load.Reason" class="form-control mb-2" placeholder="Причина" />
                    <span asp-validation-for="Load.Reason" class="text-danger"></span>
                    <button class="btn btn-primary">Зареди</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Бракуване</div>
            <div class="card-body">
                <form asp-action="Scrap" method="post">
                    @Html.AntiForgeryToken()

                    <select asp-for="Scrap.ItemType" class="form-select mb-2 js-item-type" data-target-prefix="scrap">
                        <option value="@((int)InventoryEntityType.Product)">Продукт</option>
                        <option value="@((int)InventoryEntityType.Ingredient)">Суровина</option>
                    </select>

                    <select asp-for="Scrap.ProductId" class="form-select mb-2 js-product-select" data-prefix="scrap">
                        <option value="">-- Изберете продукт --</option>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <option value="@item.ProductId">@item.Product?.Name</option>
                        }
                    </select>

                    <select asp-for="Scrap.IngredientId" class="form-select mb-2 js-ingredient-select d-none" data-prefix="scrap">
                        <option value="">-- Изберете суровина --</option>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit)</option>
                        }
                    </select>

                    <input asp-for="Scrap.Quantity" class="form-control mb-2" placeholder="Количество" />
                    <input asp-for="Scrap.Reason" class="form-control mb-2" placeholder="Причина" />
                    <span asp-validation-for="Scrap.Reason" class="text-danger"></span>
                    <button class="btn btn-warning">Бракувай</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Замяна</div>
            <div class="card-body">
                <form asp-action="Replace" method="post">
                    @Html.AntiForgeryToken()

                    <label class="form-label">От</label>
                    <select asp-for="Replace.FromItemType" class="form-select mb-2 js-item-type" data-target-prefix="replace-from">
                        <option value="@((int)InventoryEntityType.Product)">Продукт</option>
                        <option value="@((int)InventoryEntityType.Ingredient)">Суровина</option>
                    </select>

                    <select asp-for="Replace.FromProductId" class="form-select mb-2 js-product-select" data-prefix="replace-from">
                        <option value="">-- Изберете продукт --</option>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <option value="@item.ProductId">@item.Product?.Name</option>
                        }
                    </select>

                    <select asp-for="Replace.FromIngredientId" class="form-select mb-2 js-ingredient-select d-none" data-prefix="replace-from">
                        <option value="">-- Изберете суровина --</option>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit)</option>
                        }
                    </select>

                    <label class="form-label">Към</label>
                    <select asp-for="Replace.ToItemType" class="form-select mb-2 js-item-type" data-target-prefix="replace-to">
                        <option value="@((int)InventoryEntityType.Product)">Продукт</option>
                        <option value="@((int)InventoryEntityType.Ingredient)">Суровина</option>
                    </select>

                    <select asp-for="Replace.ToProductId" class="form-select mb-2 js-product-select" data-prefix="replace-to">
                        <option value="">-- Изберете продукт --</option>
                        @foreach (var item in Model.InventoryItems)
                        {
                            <option value="@item.ProductId">@item.Product?.Name</option>
                        }
                    </select>

                    <select asp-for="Replace.ToIngredientId" class="form-select mb-2 js-ingredient-select d-none" data-prefix="replace-to">
                        <option value="">-- Изберете суровина --</option>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit)</option>
                        }
                    </select>

                    <input asp-for="Replace.Quantity" class="form-control mb-2" placeholder="Количество" />
                    <input asp-for="Replace.Reason" class="form-control mb-2" placeholder="Причина" />
                    <span asp-validation-for="Replace.Reason" class="text-danger"></span>
                    <button class="btn btn-secondary">Замени</button>
                </form>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Текущи наличности</h4>
<table class="table">
    <thead>
        <tr><th>Продукт</th><th>Кол.</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.InventoryItems)
        {
            <tr><td>@item.Product?.Name</td><td>@item.QuantityOnHand</td></tr>
        }
    </tbody>
</table>

<h4 class="mt-4">Наличност на суровини</h4>
<table class="table">
    <thead>
        <tr><th>Суровина</th><th>Мярка</th><th>Кол.</th></tr>
    </thead>
    <tbody>
        @foreach (var ingredient in Model.Ingredients)
        {
            <tr><td>@ingredient.Name</td><td>@ingredient.Unit</td><td>@ingredient.QuantityOnHand</td></tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const PRODUCT = '@((int)InventoryEntityType.Product)';

            function toggleByType(selector) {
                const prefix = selector.dataset.targetPrefix;
                const productSelect = document.querySelector(`.js-product-select[data-prefix="${prefix}"]`);
                const ingredientSelect = document.querySelector(`.js-ingredient-select[data-prefix="${prefix}"]`);
                if (!productSelect || !ingredientSelect) return;

                const isProduct = selector.value === PRODUCT;
                productSelect.classList.toggle('d-none', !isProduct);
                ingredientSelect.classList.toggle('d-none', isProduct);

                if (isProduct) {
                    ingredientSelect.value = '';
                } else {
                    productSelect.value = '';
                }
            }

            document.querySelectorAll('.js-item-type').forEach(selector => {
                selector.addEventListener('change', () => toggleByType(selector));
                toggleByType(selector);
            });
        })();
    </script>
}
